{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dust-guard-vn",
  "account_id": "5fdd1d1433519df6429d7418d43fff9a",
  "main": "server/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dustguard-production",
      "database_id": "ad40205a-ec4b-40f3-8ab2-c2e7b9e78699",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "dustguard-storage"
    },
    {
      "binding": "EVIDENCE_BUCKET",
      "bucket_name": "dustguard-storage"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://dustguard.phamphunguyenhung.com",
    "ALLOWED_ORIGINS": "https://dustguard.phamphunguyenhung.com,https://dust-guard-vn.phamphunguyenhung.workers.dev,http://localhost:3000,http://localhost:3002,http://localhost:8787",
    "INTEGRATION_SERVICE_KEY": "dustguard-internal-2026"
  },
  "routes": [
    {
      "pattern": "dustguard.phamphunguyenhung.com",
      "custom_domain": true
    }
  ]
}
