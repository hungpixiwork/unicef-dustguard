{
  "name": "unicef-dustguard-root",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:prod": "node scripts/build-production.js",
    "deploy:prod": "node scripts/build-production.js && npx wrangler deploy",
    "operations:dev": "npm --prefix dustguard-operations run dev",
    "operations:setup": "npm --prefix dustguard-operations run setup",
    "operations:test": "npm --prefix dustguard-operations run test",
    "operations:build": "npm --prefix dustguard-operations run build",
    "operations:test:responsive": "npm --prefix dustguard-operations run test:responsive",
    "dev": "node scripts/community-dev.js",
    "dev:community": "node scripts/community-dev.js",
    "dev:core": "npm --prefix app run dev",
    "dev:server": "npm --prefix apps/server run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "setup": "node scripts/community-setup.js",
    "db:migrate": "npm --prefix apps/server run db:migrate",
    "db:seed": "npm --prefix apps/server run db:seed",
    "db:reset": "npm --prefix apps/server run db:reset",
    "build:community": "npm --prefix apps/server run build && npm --prefix apps/web run build",
    "test:community": "node --test tests/community-api.test.js",
    "dev:web:core": "npm --prefix app run dev:web",
    "dev:worker": "npm --prefix app run dev:worker",
    "build": "npm --prefix apps/web run build",
    "test": "node --test tests/community-api.test.js",
    "verify": "npm --prefix app run verify",
    "verify:quick": "npm --prefix app run verify:quick",
    "lint": "npm --prefix app run verify:quick",
    "verify:dustguard": "npm --prefix app run verify:dustguard",
    "verify:runtime": "npm --prefix app run verify:runtime",
    "sensor:simulate": "npm --prefix app run sensor:simulate",
    "simulate:sensor": "npm --prefix app run simulate:sensor",
    "demo:reset": "npm --prefix app run demo:reset",
    "harness": "node scripts/harness.js",
    "harness:audit": "node scripts/harness.js audit",
    "harness:spec": "node scripts/harness.js spec",
    "harness:verify": "node scripts/harness.js verify",
    "harness:review": "node scripts/harness.js review",
    "harness:journey": "node scripts/harness.js journey",
    "harness:release-check": "node scripts/harness.js release-check"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.7"
  }
}
